---
import Card from "@components/building-blocks/wrappers/card/Card.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";

const {
  link = "",
  image,
  title = "",
  description = "",
  date,
  
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const pubDate = date?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

if (!_component && !title) return;
---

<Card
  class:list={["article", className]}
  link={link}
  {...htmlAttributes}
>
  {image && (
    <Fragment slot="before">
      <Image
        class="image--mobile"
        source="/blog/crm-forms-in-react.jpg"
        alt={image.alt}
        aspectRatio="landscape"
        rounded={true}
      />
      <Image
        class="image--desktop"
        source={image.src}
        alt={image.alt}
        aspectRatio="square"
        rounded={true}
      />
    </Fragment>
  )}

  <SimpleText
    size="sm"
    class="meta"
    text={pubDate}
  />
  <Heading
    level="h3"
    size="xs"
    text={title}
  />
  {description && (
    <SimpleText
      class="description"
      text={description}
    />
  )}
  {link && (
    <div slot="after" class="text-cta">Read article</div>
  )}
</Card>

<style>
  @import "/src/styles/variables/_breakpoints.css";

  @layer components {
    .article {
      .text-cta {
        text-transform: uppercase;
        text-decoration: underline;
        font-size: var(--font-size-sm);
        letter-spacing: 13%;
      }
      .image {
        margin: 0;
      }
      .heading {
        margin-block: var(--spacing-sm);
      }
      .description {
        margin-top: var(--spacing-sm);
        max-width: 60ch;
      }
      :global(.card-inner) {
        display: grid !important;
        grid-template-columns: auto;
        grid-template-rows: auto auto;
        gap: var(--spacing-md);
      }

      @media (--bp-md-down) {
        .image--desktop {
          display: none;
        }
      }

      @media (--bp-md) {
        .image--mobile {
          display: none;
        }
        :global(.before-content) {
          grid-row: 1 / span 2;
        }
        :global(.card-inner) {
          grid-template-columns: minmax(auto, 260px) minmax(70%, 1fr);
          grid-template-rows: auto 1fr;
        }
        :global(.after-content) {
          grid-column: 2;
        }
      }
    }
  }
</style>
