---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Bar from "@components/navigation/bar/Bar.astro";
import Button from "@core-elements/button/Button.astro";
import Text from "@core-elements/text/Text.astro";
import TypefaceLogo from "@core-elements/typeface-logo/TypefaceLogo.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import type { SocialLink } from "src/types";

const {
  logoText,
  brandMessage,
  links = [],
  socials = [] as SocialLink[],
  footerText = "",
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<footer
  class="footer"
  {...htmlAttributes}
>
  <CustomSection
    maxContentWidth="2xl"
    paddingHorizontal="md"
    paddingVertical="2xl"
    useDefaultEditableBinding={false}
    colorScheme="dark"
    backgroundColor="base"
  >
    
    <div class="footer__brand">
      <a href="/">
        <TypefaceLogo
          logoText={logoText}
          brandMessage={brandMessage}
        />
      </a>
    </div>

    <div class="footer__text">
      <Text
        text={footerText || ""}
        data-prop=""
        useDefaultEditableBinding={false}
      />
    </div>

    <div class="footer__nav">
      <Bar
        navData={links}
        useDefaultEditableBinding={false}
      />
    </div>

    <div class="footer__links">
      <ButtonGroup
        direction="row"
        useDefaultEditableBinding={false}
      >
        {
          socials.map((social: SocialLink) => (
            <Button
              variant="ghost"
              size="lg"
              iconName={social.icon}
              link={social.link}
              hideText="true"
              aria-label={social.label || `Visit our ${social.icon.replace(/^.*\//, "")} page`}
              target="_blank"
              rel="noopener noreferrer"
              useDefaultEditableBinding={false}
            />
          ))
        }
      </ButtonGroup>
    </div>

    <div class="footer__legal">
      &copy; {new Date().getFullYear()} All rights reserved.
    </div>

  </CustomSection>
</footer>

<style>
  @import "/src/styles/variables/_breakpoints.css";

  @layer page-sections {
    .footer {
      .footer__links {
        :global(.button-group) {
          container-type: unset;
        }
      }
      .footer__text {
        :global(.text) {
          margin-top: 0;
        }
      }
      .footer__legal {
        font-size: var(--font-size-xs);
        opacity: 0.6;
      }
      :global(.outer-content > .content) {
        display: flex;
      }
      @media (--bp-lg-down) {
        .footer__text {
          :global(.text) {
            max-width: 50ch;
          }
          :global(.text-inner) {
            text-align: center;
          }
        }
        .footer__brand {
          :global(.typeface-logo) {
            align-items: center;
          }
        }
        .footer__links {
          :global(.button-group) {
            margin-top: 0;
          }
        }
        :global(.outer-content > .content) {
          flex-direction: column;
          align-items: center;
          gap: var(--spacing-md)
        }
      }

      @media (--bp-lg) {
        .footer__legal {
          flex: 1 0 100%;
          text-align: center;
        }
        .footer__text {
          flex: 1 0 20%;
          :global(.text) {
            max-width: 30ch;
          }
          :global(.text-inner p:first-child) {
            margin-top: 0;
          }
          :global(.text-inner p:last-child) {
            margin-bottom: 0;
          }
        }
        .footer__links {
          :global(.button-group) {
            margin-top: var(--spacing-xs);
          }
        }
        :global(.outer-content > .content) {
          flex-direction: row;
          flex-wrap: wrap;
          gap: var(--spacing-2xl);
        }
      }
    }
  }
</style>
