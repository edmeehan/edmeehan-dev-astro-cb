---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";

type FeatureProps = Record<string, unknown>;

const {
  eyebrow = "",
  heading = "",
  content = "",
  colorScheme = "inherit",
  backgroundColor,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["mini-editorial", className]}
  maxContentWidth="lg"
  paddingHorizontal="lg"
  paddingVertical="3xl"
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <SimpleText
    alignX="center"
    class="eyebrow"
    size="sm"
    data-prop="eyebrow"
    text={eyebrow}
  />
  <Heading
    level="h2"
    size="lg"
    alignX="center"
    data-prop="heading"
    text={heading}
  />
  <Text
    class="main-content"
    alignX="start"
    data-prop="content"
    text={content}
  />
</CustomSection>

<style>
  @import "/src/styles/variables/_breakpoints.css";

  @layer page-sections {
    @media (--bp-md-down) {
      .mini-editorial {
        :global(> .outer-content > .content) {
          /* padding-block-start: var(--spacing-3xl); */
        }
      }
    }

    @media (--bp-md) {
      .mini-editorial {
        .heading {
          max-width: 50ch;
          margin-inline: auto;
        }
        .main-content {
          margin-top: var(--spacing-2xl);
          :global(.text-inner) {
            column-count: 2;
            column-gap: var(--spacing-2xl);

            :global(p:first-child) {
              margin-top: 0;
            }
            :global(p:last-child) {
              margin-bottom: 0;
            }
          }
        }
        :global(> .outer-content > .content) {
          padding-block: var(--spacing-6xl);
        }
      }
    }
  }
</style>
