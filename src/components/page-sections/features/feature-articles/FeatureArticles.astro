---
import Article from "@core-elements/article/Article.astro";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import CustomSection from "@page-sections/builders/custom-section/CustomSection.astro";
import { getCollection } from "astro:content";

type ArticleProps = Record<string, unknown>;

const {
  eyebrow = "",
  heading = "",
  subtext = "",
  posts = [],
  colorScheme = "inherit",
  backgroundColor,
  paddingVertical = "4xl",
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const allPosts = await getCollection("blog");

const featured_posts = posts.map((postPath: string) => {
  // CloudCannon document picker stores the full path; match against post.id (filename only)
  const postId = postPath?.split("/")?.pop() ?? "";
  const normalizedPath = postId.replace(/\.(mdx?|ya?ml|json)$/, "");
  const post = allPosts.find((p) => p.id === normalizedPath);
  return post;
});
---

<CustomSection
  class:list={["feature-articles", className]}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  {...htmlAttributes}
>
  <SimpleText
    alignX="start"
    class="eyebrow"
    size="sm"
    data-prop="eyebrow"
    text={eyebrow}
  />
  <Heading
    level="h2"
    size="xl"
    alignX="start"
    data-prop="heading"
    text={heading}
  />
  <Text
    class="subtext"
    alignX="start"
    data-prop="subtext"
    text={subtext}
  />
  { featured_posts.length > 0 ? (
    <div class="articles">
    { featured_posts.map((post: ArticleProps) => (
      <Article
        data-id="building-blocks/core-elements/article/article"
        data-editable="array-item"
        link={`/blog/${post.id}`}
        {...post.data}
      />
    ))}
    </div>
  ) : (
    _component && (
      <SimpleText
        class="feature-articles-empty"
        text="Select a blog post to feature."
      />
    )
  )}
</CustomSection>

<style>
  @layer page-sections {
    .feature-articles {

    }
    .eyebrow {

    }
    .subtext {
      
    }
    .articles {

    }
    .feature-articles-empty {
      color: var(--color-text-muted);
      font-style: italic;
    }
  }
</style>
